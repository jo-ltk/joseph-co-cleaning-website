# ─── Production (set all of these in Vercel/hosting → Environment Variables) ───

# MongoDB Atlas — Connect → Drivers → copy connection string (not the dummy below)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/josephco?retryWrites=true&w=majority

# Cloudinary — Dashboard → API Keys (portfolio image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend — API Keys + verified sending domain
RESEND_API_KEY=re_xxxxxxxxx
ADMIN_EMAIL=josephandcocleaningservicesltd@gmail.com
CUSTOMER_FROM_EMAIL=bookings@mail.josephcleaning.co.uk

# Admin panel (/admin/login) — use strong values in production
ADMIN_USER=admin
ADMIN_PASS=change-me-to-a-long-random-password
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Instagram Graph API (homepage “Behind The Build” highlights)
# Connect a Business/Creator account to a Meta app, then issue a long-lived token
# with instagram_basic + pages_read_engagement. User ID is optional if /me works.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Chatbot (optional — /api/chatbot returns errors if missing)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# Site contact (used in .env.example for reference; some values are hardcoded in booking.tsx)
WHATSAPP_PRIMARY=447787857305
WHATSAPP_SECONDARY=447570421556
